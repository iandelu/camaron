#!/bin/sh
# Camarón's git hook dispatcher. `core.hooksPath` points at this folder (camaron guard install) and every git hook name
# in it is a copy of this file. For the hook that ran: first the kit's own check (kit/<name>), which can stop the git
# operation; then the repo's own hook of the same name, so husky, pre-commit and hand-written hooks keep working.
# Where the repo's hooks are: the folder `git config camaron.chain` holds (what core.hooksPath was before the kit set
# it; relative to the top of the repo, as husky sets it), else the repo's own .git/hooks.
name=$(basename "$0")
here=$(cd "$(dirname "$0")" && pwd)
feed=""
case $name in
    pre-push|post-rewrite)       # these read stdin: the kit's check and the repo's hook both see it
        feed=$(mktemp "${TMPDIR:-/tmp}/camaron-hook.XXXXXX") || exit 0
        trap 'rm -f "$feed"' EXIT
        cat > "$feed" ;;
esac
run() { if [ -n "$feed" ]; then "$@" < "$feed"; else "$@"; fi; }

if [ -x "$here/kit/$name" ]; then
    run "$here/kit/$name" "$@" || exit $?
fi
chain=$(git config --get camaron.chain)
case $chain in
    "") chain=$(git rev-parse --git-common-dir)/hooks ;;
    /*|[A-Za-z]:*) ;;
    *) chain=$(git rev-parse --show-toplevel)/$chain ;;
esac
if [ -x "$chain/$name" ] && [ "$chain/$name" != "$here/$name" ]; then
    run "$chain/$name" "$@"
    exit $?
fi
exit 0
