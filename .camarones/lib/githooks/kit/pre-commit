#!/bin/sh
# Keep secrets out of a commit: gitleaks runs on what is staged and prints file, line and rule, the value redacted.
# The binary is the kit's pinned copy (~/.camarones/bin/gitleaks-<version>/), else one on PATH. With none, or when it
# fails on its own, the commit goes through with a warning: a missing scanner never blocks the work.
# A false positive: `git commit --no-verify`.
leak=99
exe=""
for p in "$HOME"/.camarones/bin/gitleaks-*/gitleaks "$HOME"/.camarones/bin/gitleaks-*/gitleaks.exe; do
    [ -f "$p" ] && exe="$p"
done
[ -z "$exe" ] && exe=$(command -v gitleaks)
if [ -z "$exe" ]; then
    echo "pre-commit: gitleaks not found, staged changes were not scanned for secrets (camaron setup installs it)" >&2
    exit 0
fi
"$exe" git --pre-commit --staged --redact --no-banner --no-color --exit-code "$leak" --verbose . >&2
case $? in
    0) exit 0 ;;
    "$leak")
        echo "commit refused: possible secret in the staged changes (value redacted above). Remove it or use a placeholder;" >&2
        echo "if it is a false positive, commit with --no-verify." >&2
        exit 1 ;;
    *)
        echo "pre-commit: gitleaks could not scan the staged changes, committing without the scan" >&2
        exit 0 ;;
esac
